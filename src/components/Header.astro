---
import { physicalServices, digitalServices, serviceUrl } from "@/data/services";
import { site } from "@/data/site";
import ArrowIcon from "./ArrowIcon.astro";

type NavLink = {
  href: string;
  label: string;
  submenu?: { href: string; label: string }[];
};

const navLinks: NavLink[] = [
  {
    href: "/security-services/",
    label: "Services",
    submenu: physicalServices.map((s) => ({ href: serviceUrl(s), label: s.shortTitle })),
  },
  {
    href: "/security-systems/",
    label: "Systems",
    submenu: digitalServices.map((s) => ({ href: serviceUrl(s), label: s.shortTitle })),
  },
  { href: "/training/", label: "Training" },
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/about/", label: "About" },
  { href: "/careers/", label: "Careers" },
];

const instagramLink = site.social.find((s) => s.platform === "Instagram");
const linkedinLink = site.social.find((s) => s.platform === "LinkedIn");

const headerActions = [
  {
    href: site.primaryCta.href,
    label: "Quote",
    tone: "quote",
    ariaLabel: site.primaryCta.label,
  },
  {
    href: site.contact.phoneHref,
    label: "Call",
    tone: "call",
    ariaLabel: `Call Accure Security at ${site.contact.phoneDisplay}`,
  },
  {
    href: site.contact.whatsappHref,
    label: "WhatsApp",
    tone: "whatsapp",
    ariaLabel: "Chat with Accure Security on WhatsApp",
    external: true,
    iconOnly: false,
  },
  ...(instagramLink
    ? [
        {
          href: instagramLink.href,
          label: "Instagram",
          tone: "instagram",
          ariaLabel: instagramLink.label,
          external: true,
          iconOnly: true,
        },
      ]
    : []),
  ...(linkedinLink
    ? [
        {
          href: linkedinLink.href,
          label: "LinkedIn",
          tone: "linkedin",
          ariaLabel: linkedinLink.label,
          external: true,
          iconOnly: true,
        },
      ]
    : []),
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="site-header fixed inset-x-0 top-0 z-40 pointer-events-none px-3 py-4 sm:px-6">
  <nav class="site-header-nav mx-auto flex max-w-[1320px] items-center justify-between gap-2 rounded-full border border-black/15 bg-[#fffaf1]/96 p-2 shadow-[var(--shadow-md)] backdrop-blur-2xl pointer-events-auto">
    <a href="/" class="flex shrink-0 items-center gap-3 rounded-full pl-2 pr-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accure-red)]">
      <img src={site.logo} alt="Accure Security logo" class="h-11 w-11 rounded-full object-contain" />
      <span class="hidden leading-none sm:block">
        <span class="block font-display text-2xl font-bold text-[var(--ink)]">Accure</span>
        <span class="font-utility block text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-[var(--accure-red)]">Security</span>
      </span>
    </a>

    <div class="header-desktop-controls hidden min-w-0 items-center gap-1 lg:flex">
      {navLinks.map((link) => (
        link.submenu ? (
          <div class="nav-dropdown relative">
            <a
              class:list={[
                "nav-dropdown-trigger inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-bold transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-black/5 hover:text-[var(--ink)]",
                isActive(link.href) ? "bg-[rgba(179,31,37,0.1)] text-[var(--accure-red-dark)]" : "text-[var(--ink)]",
              ]}
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {link.label}
              <svg width="10" height="6" viewBox="0 0 10 6" class="nav-dropdown-caret transition duration-300" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </svg>
            </a>
            <div class="nav-dropdown-panel absolute left-0 top-full mt-2 min-w-[240px] origin-top scale-95 rounded-2xl border border-black/10 bg-[#fffaf1] p-2 opacity-0 shadow-[var(--shadow-md)] pointer-events-none transition duration-200 ease-[cubic-bezier(0.32,0.72,0,1)]" role="menu">
              {link.submenu.map((item) => (
                <a
                  href={item.href}
                  role="menuitem"
                  class:list={[
                    "block rounded-xl px-3.5 py-2.5 text-sm font-semibold transition duration-200 hover:bg-black/5 hover:text-[var(--accure-red-dark)]",
                    currentPath === item.href ? "bg-[rgba(179,31,37,0.08)] text-[var(--accure-red-dark)]" : "text-[var(--ink)]",
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            class:list={[
              "rounded-full px-3.5 py-2 text-sm font-bold transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-black/5 hover:text-[var(--ink)]",
              isActive(link.href) ? "bg-[rgba(179,31,37,0.1)] text-[var(--accure-red-dark)]" : "text-[var(--ink)]",
            ]}
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        )
      ))}
      <div class="header-actions ml-2 flex items-center gap-2 border-l border-black/10 pl-2">
        {headerActions.map((action) => (
          <a
            href={action.href}
            target={action.external ? "_blank" : undefined}
            rel={action.external ? "noopener" : undefined}
            aria-label={action.ariaLabel}
            class:list={["header-action-pill", `header-action-${action.tone}`, action.iconOnly && "header-action-icon-only"]}
          >
            {action.tone === "instagram" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            )}
            {action.tone === "linkedin" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
              </svg>
            )}
            {!action.iconOnly && <span>{action.label}</span>}
            {action.tone === "quote" && (
              <span class="header-action-icon">
                <ArrowIcon class="h-3.5 w-3.5" />
              </span>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="header-request-slot hidden shrink-0 items-center gap-2 lg:flex">
      <a href="/contact/" class="header-request-link">
        24/7 request
      </a>
    </div>

    <button
      class="menu-toggle relative grid h-12 w-12 place-items-center rounded-full bg-[var(--ink)] text-white lg:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation"
    >
      <span class="hamburger-line absolute h-px w-5 -translate-y-1.5 bg-current transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"></span>
      <span class="hamburger-line absolute h-px w-5 translate-y-1.5 bg-current transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-50 hidden bg-[var(--charcoal)]/96 px-4 py-5 text-[#fffdf8] backdrop-blur-2xl lg:hidden"
>
  <div class="mx-auto flex max-w-xl flex-col gap-8">
    <div class="flex items-center justify-between rounded-full border border-white/10 bg-white/8 p-2">
      <a href="/" class="flex items-center gap-3">
        <img src={site.logo} alt="Accure Security logo" class="h-11 w-11 rounded-full object-contain" />
        <span class="font-display text-2xl font-bold">Accure Security</span>
      </a>
      <button class="menu-close grid h-12 w-12 place-items-center rounded-full bg-white text-[var(--ink)]" type="button" aria-label="Close navigation">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4 4L14 14M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="grid gap-3">
      {navLinks.map((link, index) => (
        <a style={`--i:${index}`} class="mobile-menu-link translate-y-8 rounded-[1.4rem] border border-white/10 bg-white/8 px-5 py-4 text-3xl font-display font-bold opacity-0 transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]" href={link.href}>
          {link.label}
        </a>
      ))}
      <a style={`--i:${navLinks.length}`} class="mobile-menu-link translate-y-8 rounded-[1.4rem] bg-[var(--accure-red)] px-5 py-4 text-3xl font-display font-bold opacity-0 transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]" href="/contact/">
        Request a quote
      </a>
      <div style={`--i:${navLinks.length + 1}`} class="mobile-menu-link mobile-contact-grid translate-y-8 opacity-0 transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]">
        <a class="mobile-contact-action mobile-contact-call" href={site.contact.phoneHref} aria-label={`Call Accure Security at ${site.contact.phoneDisplay}`}>
          <span>Call</span>
          <small>{site.contact.phoneDisplay}</small>
        </a>
        <a class="mobile-contact-action mobile-contact-whatsapp" href={site.contact.whatsappHref} target="_blank" rel="noopener" aria-label="Chat with Accure Security on WhatsApp">
          <span>WhatsApp</span>
          <small>Chat now</small>
        </a>
      </div>
    </div>

    <div class="grid gap-8 border-t border-white/10 pt-8">
      <div>
        <p class="font-utility text-xs font-semibold uppercase tracking-[0.2em] text-[#f1e8db]">Physical security</p>
        <div class="mt-4 grid gap-2">
          {physicalServices.slice(0, 5).map((service) => (
            <a class="font-semibold text-[#fffdf8]" href={serviceUrl(service)}>{service.shortTitle}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const toggle = document.querySelector(".menu-toggle");
  const close = document.querySelector(".menu-close");
  const menu = document.querySelector(".mobile-menu");
  const header = document.querySelector(".site-header");
  const links = document.querySelectorAll(".mobile-menu-link");
  const lines = document.querySelectorAll(".hamburger-line");
  let lastScrollY = window.scrollY;
  let scrollTicking = false;

  function setMenu(open) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    menu.classList.toggle("hidden", !open);
    header?.classList.remove("site-header-hidden");
    document.documentElement.classList.toggle("overflow-hidden", open);
    lines[0]?.classList.toggle("rotate-45", open);
    lines[0]?.classList.toggle("translate-y-0", open);
    lines[1]?.classList.toggle("-rotate-45", open);
    lines[1]?.classList.toggle("translate-y-0", open);
    requestAnimationFrame(() => {
      links.forEach((link) => {
        link.classList.toggle("opacity-100", open);
        link.classList.toggle("translate-y-0", open);
        link.style.transitionDelay = open ? `calc(var(--i) * 70ms + 90ms)` : "0ms";
      });
    });
  }

  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  close?.addEventListener("click", () => setMenu(false));
  links.forEach((link) => link.addEventListener("click", () => setMenu(false)));
  header?.addEventListener("focusin", () => header.classList.remove("site-header-hidden"));

  function updateHeaderVisibility() {
    if (!header || toggle?.getAttribute("aria-expanded") === "true") {
      scrollTicking = false;
      return;
    }

    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;
    header.classList.toggle("site-header-scrolled", currentScrollY > 24);

    if (currentScrollY < 90 || delta < -8) {
      header.classList.remove("site-header-hidden");
    } else if (delta > 8) {
      header.classList.add("site-header-hidden");
    }

    lastScrollY = currentScrollY;
    scrollTicking = false;
  }

  window.addEventListener("scroll", () => {
    if (scrollTicking) return;
    scrollTicking = true;
    window.requestAnimationFrame(updateHeaderVisibility);
  }, { passive: true });

  header?.classList.toggle("site-header-scrolled", window.scrollY > 24);

  // Nav dropdown open/close (hover + focus + click for touch)
  document.querySelectorAll(".nav-dropdown").forEach((dd) => {
    const trigger = dd.querySelector(".nav-dropdown-trigger");
    let hoverTimer;
    const open = () => {
      dd.classList.add("is-open");
      trigger?.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dd.classList.remove("is-open");
      trigger?.setAttribute("aria-expanded", "false");
    };
    dd.addEventListener("mouseenter", () => { clearTimeout(hoverTimer); open(); });
    dd.addEventListener("mouseleave", () => { hoverTimer = setTimeout(close, 180); });
    dd.addEventListener("focusin", open);
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains(e.relatedTarget)) close();
    });
  });
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".nav-dropdown.is-open").forEach((dd) => {
      if (!dd.contains(e.target)) {
        dd.classList.remove("is-open");
        dd.querySelector(".nav-dropdown-trigger")?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>

<style>
  .nav-dropdown-panel { transform-origin: top; }
  .nav-dropdown.is-open .nav-dropdown-panel {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
  .nav-dropdown.is-open .nav-dropdown-caret {
    transform: rotate(180deg);
  }
</style>
