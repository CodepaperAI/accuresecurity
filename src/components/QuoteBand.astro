---
import Button from "./Button.astro";
---

<section class="section-shell py-16 md:py-24">
  <div class="bezel">
    <div class="bezel-core dark-panel scanline px-6 py-14 sm:px-10 lg:px-16">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <span class="eyebrow border-white/20 bg-white/12 text-[#fffdf8]" data-reveal="fade-up">Coverage request</span>
          <h2 class="headline mt-6 max-w-4xl section-title text-[#fffdf8]" data-motion-text="words">
            Tell us what needs protecting.
          </h2>
        </div>
        <div class="lg:justify-self-end" data-reveal="fade-up">
          <p class="copy max-w-xl text-[#fffdf8]">
            Share the property type, address, required hours, and risk concerns. Accure can shape a guard, patrol, event, monitoring, CCTV, or access-control plan around the site.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href="/contact/" label="Request a security quote" />
            <Button href="/security-services/" label="Review services" variant="secondary" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
