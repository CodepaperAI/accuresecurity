---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MediaHero from "@/components/MediaHero.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import { processSteps, trustSignals } from "@/data/site";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "About", url: "/about/" },
  ]),
];
---

<BaseLayout
  title="About Accure Security | Ontario Security Services"
  description="Learn about Accure Security's Ontario security services, field-first planning, licensed guards, mobile patrol, event security, monitoring, CCTV, and access control."
  canonical="/about/"
  image="/images/services/campus-security.jpg"
  schema={schema}
>
  <MediaHero
    eyebrow="About Accure"
    title="Security built around people, property, and procedure."
    text="Accure Security provides physical and digital security services for Ontario organizations that need reliable field presence, responsive planning, and clear reporting."
    image="/images/services/campus-security.jpg"
    alt="Accure Security officers providing visible campus and public-site coverage."
    actions={[{ href: "/contact/", label: "Start a coverage plan" }]}
  />

  <section class="section-shell py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionIntro
        eyebrow="Operating principles"
        title="Visible presence matters. So does what happens after the first observation."
        text="The site and service architecture are designed around the same idea: make it easy for property managers, event organizers, and facility leaders to understand what Accure can deploy."
      />
      <div class="grid gap-4" data-reveal-group>
        {trustSignals.map((signal, index) => (
          <div class="bezel" data-reveal-item>
            <div class="bezel-core flex gap-5 p-6">
              <span class="font-utility text-sm font-semibold text-[var(--accure-red)]">0{index + 1}</span>
              <p class="font-semibold text-lg">{signal}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-panel py-16 text-[#fffdf8] md:py-24">
    <div class="section-shell">
      <SectionIntro
        eyebrow="Method"
        title="From site assessment to documented reporting."
        inverted
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2" data-reveal-group>
        {processSteps.map((step) => (
          <article class="rounded-[1.2rem] border border-white/12 bg-white/10 p-7" data-reveal-item>
            <p class="font-utility text-xs font-semibold uppercase tracking-[0.18em] text-[#f1e8db]">{step.label}</p>
            <h2 class="mt-5 font-display card-title font-bold">{step.title}</h2>
            <p class="mt-5 font-medium leading-7 text-[#fffdf8]">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
