---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import ArrowIcon from "@/components/ArrowIcon.astro";
import { site } from "@/data/site";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";
import {
  getBlog,
  listBlogs,
  formatBlogDate,
  estimateReadingTime,
  blogUrl,
  coverImage,
  type UpliftBlogSummary,
} from "@/lib/upliftai";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/blog/");
}

const blog = await getBlog(slug);

if (!blog) {
  return new Response(null, { status: 404, statusText: "Blog post not found" });
}

let related: UpliftBlogSummary[] = [];
try {
  const listing = await listBlogs({ page: 1, limit: 6, status: "PUBLISH" });
  related = listing.blogs.filter((b) => b.slug !== blog.slug).slice(0, 3);
} catch (err) {
  console.error("[blog:detail] related fetch failed", err);
}

const publishedISO = blog.publishDate
  ? new Date(blog.publishDate).toISOString()
  : blog.createdAt;
const modifiedISO = blog.updatedAt ?? publishedISO;

const meta = blog.meta ?? {};
const title = meta.seoTitle || `${blog.title} | Accure Security`;
const description =
  meta.seoDescription ||
  blog.excerpt ||
  `${blog.title} — insight from the Accure Security field team.`;
const canonical = `/blog/${blog.slug}/`;
const heroImage = coverImage(blog);

const authorName = blog.authorName || "Accure Security Team";
const authorUrl = blog.authorUrl || `${site.url}/about/`;

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Field Notes", url: "/blog/" },
    { name: blog.title, url: canonical },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: blog.title,
    description,
    image: heroImage.startsWith("http") ? heroImage : new URL(heroImage, site.url).toString(),
    datePublished: publishedISO,
    dateModified: modifiedISO,
    author: {
      "@type": "Person",
      name: authorName,
      url: authorUrl,
    },
    publisher: {
      "@type": "Organization",
      name: site.legalName,
      logo: {
        "@type": "ImageObject",
        url: new URL(site.logo, site.url).toString(),
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": new URL(canonical, site.url).toString(),
    },
    keywords: (meta.keywords ?? blog.tags ?? []).join(", ") || undefined,
    articleSection: meta.articleSection ?? blog.categories?.[0],
  },
];

const readingTime = estimateReadingTime(blog.content ?? blog.excerpt);
const publishedLabel = formatBlogDate(blog.publishDate ?? blog.createdAt);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={heroImage}
  schema={schema}
>
  <article class="blog-article">
    <header class="blog-hero">
      <div class="section-shell pt-32 pb-10 md:pt-40 md:pb-14">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Field Notes</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{blog.categories?.[0] ?? "Article"}</span>
        </nav>

        <div class="mt-8 max-w-4xl">
          <p class="eyebrow" data-reveal="fade-up">
            {blog.categories?.[0] ?? "Field Notes"}
          </p>
          <h1 class="headline hero-title mt-6" data-motion-text="words">{blog.title}</h1>
          {blog.excerpt && (
            <p class="copy mt-6 max-w-3xl" data-reveal="fade-up">{blog.excerpt}</p>
          )}
          <div class="blog-meta mt-8" data-reveal="fade-up">
            <div class="blog-meta-block">
              <span class="blog-meta-label">Author</span>
              <span class="blog-meta-value">{authorName}</span>
            </div>
            {publishedLabel && (
              <div class="blog-meta-block">
                <span class="blog-meta-label">Published</span>
                <span class="blog-meta-value">{publishedLabel}</span>
              </div>
            )}
            <div class="blog-meta-block">
              <span class="blog-meta-label">Read time</span>
              <span class="blog-meta-value">{readingTime}</span>
            </div>
            {blog.categories?.[0] && (
              <div class="blog-meta-block">
                <span class="blog-meta-label">Category</span>
                <span class="blog-meta-value">{blog.categories[0]}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </header>

    {blog.featuredImage && (
      <div class="section-shell">
        <figure class="bezel" data-reveal-item data-image-reveal>
          <div class="bezel-core">
            <img
              src={blog.featuredImage}
              alt={blog.title}
              loading="eager"
              decoding="async"
              class="aspect-[16/8] w-full object-cover"
            />
          </div>
        </figure>
      </div>
    )}

    <section class="section-shell py-14 md:py-20">
      <div class="blog-layout">
        <aside class="blog-aside" aria-label="Article summary">
          <div class="blog-aside-card">
            <p class="font-utility text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-[var(--accure-red-dark)]">
              In this article
            </p>
            <p class="mt-3 font-display text-lg font-bold text-[var(--ink)]">
              {blog.title}
            </p>
            {blog.tags && blog.tags.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {blog.tags.slice(0, 6).map((tag) => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>
            )}
            <div class="mt-6 border-t border-black/10 pt-5">
              <p class="font-utility text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-[var(--ink-soft)]">
                Need coverage?
              </p>
              <a href="/contact/" class="mt-3 inline-flex items-center gap-2 font-display text-base font-bold text-[var(--accure-red-dark)] hover:text-[var(--accure-red)]">
                Request a security quote
                <ArrowIcon class="h-3.5 w-3.5" />
              </a>
              <a href={site.contact.phoneHref} class="mt-2 block font-utility text-sm font-semibold text-[var(--ink-soft)]">
                or call {site.contact.phoneDisplay}
              </a>
            </div>
          </div>
        </aside>

        <div class="blog-content">
          <div class="blog-prose" set:html={blog.content} />

          <footer class="blog-footer">
            <div class="blog-share">
              <p class="font-utility text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-[var(--ink-soft)]">Share</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <a
                  class="blog-share-link"
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(new URL(canonical, site.url).toString())}`}
                  target="_blank"
                  rel="noopener"
                >LinkedIn</a>
                <a
                  class="blog-share-link"
                  href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(new URL(canonical, site.url).toString())}&text=${encodeURIComponent(blog.title)}`}
                  target="_blank"
                  rel="noopener"
                >X / Twitter</a>
                <a
                  class="blog-share-link"
                  href={`mailto:?subject=${encodeURIComponent(blog.title)}&body=${encodeURIComponent(new URL(canonical, site.url).toString())}`}
                >Email</a>
              </div>
            </div>
            <a href="/blog/" class="button button-secondary">
              <span class="button-icon rotate-180"><ArrowIcon /></span>
              <span>All field notes</span>
            </a>
          </footer>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="section-shell pb-14 md:pb-20">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Related</p>
            <h2 class="headline section-title mt-3">Keep reading.</h2>
          </div>
          <a href="/blog/" class="hidden font-utility text-xs font-semibold uppercase tracking-[0.16em] text-[var(--ink-soft)] hover:text-[var(--accure-red-dark)] md:inline-flex md:items-center md:gap-2">
            All field notes
            <ArrowIcon class="h-3 w-3" />
          </a>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {related.map((post) => (
            <a href={blogUrl(post.slug)} class="service-card group" aria-label={`Read ${post.title}`}>
              <div class="service-card-inner">
                <div class="service-card-media">
                  <img src={coverImage(post)} alt={post.title} loading="lazy" decoding="async" />
                </div>
                <div class="service-card-body">
                  {post.categories?.[0] && (
                    <p class="service-card-kicker">{post.categories[0]}</p>
                  )}
                  <h3 class="service-card-title text-[1.25rem]">{post.title}</h3>
                  {post.excerpt && <p class="service-card-copy line-clamp-3">{post.excerpt}</p>}
                  <div class="service-card-footer">
                    <span>{formatBlogDate(post.publishDate ?? post.createdAt)}</span>
                    <span class="service-card-icon ml-auto">
                      <ArrowIcon class="h-3.5 w-3.5" />
                    </span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <QuoteBand />
</BaseLayout>

<style>
  .blog-hero {
    background:
      radial-gradient(circle at 12% 3%, rgba(179,31,37,0.10), transparent 26rem),
      radial-gradient(circle at 88% 10%, rgba(21,21,21,0.06), transparent 30rem),
      linear-gradient(180deg, #fffdf8 0%, var(--paper) 68%);
  }

  .blog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .blog-breadcrumb a:hover {
    color: var(--accure-red-dark);
  }

  .blog-breadcrumb [aria-current="page"] {
    color: var(--accure-red-dark);
  }

  .blog-meta {
    display: grid;
    gap: 0.75rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
    padding-top: 1.5rem;
    border-top: 1px solid rgba(21, 21, 21, 0.14);
  }

  .blog-meta-block {
    display: grid;
    gap: 0.28rem;
  }

  .blog-meta-label {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .blog-meta-value {
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
  }

  .blog-layout {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 1024px) {
    .blog-layout {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .blog-aside {
    position: relative;
  }

  @media (min-width: 1024px) {
    .blog-aside {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .blog-aside-card {
    border: 1px solid rgba(21, 21, 21, 0.12);
    border-radius: 1.35rem;
    background: rgba(255, 250, 241, 0.85);
    padding: 1.5rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 24px 64px -52px rgba(75, 43, 24, 0.4);
  }

  .blog-tag {
    display: inline-flex;
    padding: 0.32rem 0.68rem;
    border-radius: 999px;
    background: rgba(179, 31, 37, 0.08);
    color: var(--accure-red-dark);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .blog-content {
    min-width: 0;
  }

  .blog-prose {
    max-width: 68ch;
    color: var(--ink);
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.02rem, 0.94rem + 0.32vw, 1.14rem);
    line-height: 1.82;
    font-weight: 500;
  }

  .blog-prose > * + * {
    margin-top: 1.4rem;
  }

  .blog-prose h2 {
    margin-top: 3rem;
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.55rem, 1.35rem + 0.9vw, 2.1rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--ink);
  }

  .blog-prose h3 {
    margin-top: 2.4rem;
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.28rem, 1.14rem + 0.55vw, 1.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--ink);
  }

  .blog-prose h4 {
    margin-top: 2rem;
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.14rem;
    font-weight: 800;
    color: var(--ink);
  }

  .blog-prose p,
  .blog-prose li {
    text-wrap: pretty;
  }

  .blog-prose a {
    color: var(--accure-red-dark);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
    transition: color 200ms var(--ease-out);
  }

  .blog-prose a:hover {
    color: var(--accure-red);
  }

  .blog-prose strong {
    color: var(--ink);
    font-weight: 800;
  }

  .blog-prose em {
    font-style: italic;
  }

  .blog-prose ul,
  .blog-prose ol {
    padding-left: 1.5rem;
  }

  .blog-prose ul {
    list-style: none;
  }

  .blog-prose ul li {
    position: relative;
    padding-left: 1.4rem;
  }

  .blog-prose ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--accure-red);
    box-shadow: 0 0 0 4px rgba(179, 31, 37, 0.14);
  }

  .blog-prose ol {
    list-style: decimal;
  }

  .blog-prose ol li::marker {
    color: var(--accure-red-dark);
    font-weight: 800;
  }

  .blog-prose li + li {
    margin-top: 0.7rem;
  }

  .blog-prose blockquote {
    margin: 2rem 0;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--accure-red);
    border-radius: 0 1rem 1rem 0;
    background: rgba(255, 250, 241, 0.75);
    color: var(--ink);
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.68;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .blog-prose blockquote p {
    margin: 0;
  }

  .blog-prose code {
    padding: 0.16rem 0.42rem;
    border-radius: 0.42rem;
    background: rgba(21, 21, 21, 0.06);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.88em;
  }

  .blog-prose pre {
    margin: 1.8rem 0;
    padding: 1.4rem;
    border-radius: 1.1rem;
    background: var(--charcoal);
    color: #fffdf8;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.92rem;
    line-height: 1.6;
    overflow-x: auto;
    box-shadow: var(--shadow-md);
  }

  .blog-prose pre code {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .blog-prose img {
    border-radius: 1.1rem;
    border: 1px solid rgba(21, 21, 21, 0.12);
    box-shadow: var(--shadow-md);
  }

  .blog-prose figure {
    margin: 2rem 0;
  }

  .blog-prose figcaption {
    margin-top: 0.85rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .blog-prose hr {
    margin: 2.5rem 0;
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(21, 21, 21, 0.2), transparent);
  }

  .blog-prose table {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    border: 1px solid rgba(21, 21, 21, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    font-size: 0.96rem;
  }

  .blog-prose th,
  .blog-prose td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(21, 21, 21, 0.1);
    text-align: left;
  }

  .blog-prose th {
    background: rgba(179, 31, 37, 0.06);
    font-weight: 800;
    color: var(--accure-red-dark);
  }

  .blog-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(21, 21, 21, 0.14);
  }

  .blog-share-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(21, 21, 21, 0.14);
    background: rgba(255, 250, 241, 0.7);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    transition: transform 220ms var(--ease-out), border-color 220ms var(--ease-out), background 220ms var(--ease-out), color 220ms var(--ease-out);
  }

  .blog-share-link:hover {
    transform: translateY(-1px);
    border-color: rgba(179, 31, 37, 0.28);
    background: rgba(179, 31, 37, 0.08);
    color: var(--accure-red-dark);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
