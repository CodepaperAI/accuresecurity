---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import { site } from "@/data/site";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
    { name: "Request received", url: "/contact/thanks/" },
  ]),
];
---

<BaseLayout
  title="Request Received | Accure Security"
  description="Your security quote request has been sent to the Accure Security team."
  canonical="/contact/thanks/"
  image="/images/services/control-centre-hero.jpg"
  schema={schema}
>
  <section class="section-shell pt-32 pb-24 md:pt-40 md:pb-32">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow" data-reveal="fade-up">Request received</span>
      <h1 class="headline mt-7 hero-title" data-motion-text="words">
        Thanks. Your quote request is on its way.
      </h1>
      <p class="copy mt-7 font-bold" data-reveal="fade-up">
        Thank you! Your quote request has been received — our team will respond within a short time.
      </p>
      <p class="copy mt-3" data-reveal="fade-up">
        For emergency security coverage, call our 24/7 dispatch center at 905-399-9333.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal="fade-up">
        <Button href="/" label="Back to home" />
        <Button href={site.contact.phoneHref} label={`Call ${site.contact.phoneDisplay}`} variant="secondary" />
      </div>
    </div>
  </section>
</BaseLayout>
