---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { physicalServices, digitalServices, serviceUrl } from "@/data/services";
import { locations } from "@/data/locations";
import { homepageFaqs } from "@/data/faqs";
import { processSteps, trustSignals } from "@/data/site";
import { clientLogos, portfolioImages } from "@/data/assets";
import { organizationSchema, websiteSchema, faqSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  websiteSchema(),
  faqSchema(homepageFaqs),
  breadcrumbSchema([{ name: "Home", url: "/" }]),
];

const featuredServices = [
  physicalServices[2],
  physicalServices[0],
  physicalServices[5],
  physicalServices[6],
  digitalServices[0],
  digitalServices[1],
];
---

<BaseLayout
  title="Accure Security | Security Guard Services Across Ontario"
  description="Accure Security provides security guards, mobile patrol, event security, construction site protection, remote monitoring, CCTV, and access control across Ontario."
  image="/images/portfolio/outdoor-operations-team.jpg"
  schema={schema}
>
  <section class="relative min-h-[100dvh] overflow-hidden bg-[var(--charcoal)] text-[#fffdf8]" data-parallax-section>
    <img
      src="/images/portfolio/outdoor-operations-team.jpg"
      alt="Accure Security team gathered outdoors for event security operations."
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-[108%] w-full object-cover object-[50%_55%] opacity-95"
      data-parallax-layer
      data-parallax-speed="0.04"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(12,11,10,0.86)_0%,rgba(12,11,10,0.58)_36%,rgba(12,11,10,0.18)_72%,rgba(12,11,10,0.34)_100%),linear-gradient(180deg,rgba(12,11,10,0.30)_0%,rgba(12,11,10,0.08)_42%,rgba(12,11,10,0.82)_100%)]"></div>
    <div class="section-shell relative z-10 flex min-h-[100dvh] flex-col justify-end pb-10 pt-32 md:pb-12 md:pt-36">
      <div class="max-w-3xl">
        <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[#f0c4c6]">
          Ontario / Security Operations
        </p>
        <h1 class="font-display home-hero-title mt-6 font-semibold tracking-[0]" data-motion-text="words">
          Ontario security for sites and events.
        </h1>
        <div class="mt-7 h-px max-w-2xl bg-white/24"></div>
        <p class="mt-6 max-w-[52ch] text-[1.03rem] font-semibold leading-8 text-[#fffdf8] md:text-[1.12rem]">
          Licensed guards, patrol response, event teams, fire watch, CCTV, access control, and remote monitoring for sites that need visible, documented coverage.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/contact/" data-magnetic="0.12" class="group inline-flex items-center justify-center gap-3 rounded-full bg-[var(--accure-red)] px-5 py-3.5 text-sm font-extrabold text-white shadow-[0_18px_45px_-25px_rgba(0,0,0,0.8)] transition duration-300 hover:bg-[#d3242c]">
            Request a security quote <span aria-hidden="true" class="grid h-8 w-8 place-items-center rounded-full bg-white text-[var(--accure-red)] transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/security-services/" data-magnetic="0.12" class="group inline-flex items-center justify-center gap-2 rounded-full border border-white/28 bg-white/10 px-5 py-3.5 font-utility text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-white backdrop-blur-md transition duration-300 hover:bg-white/18">
            Explore services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="mt-12 grid max-w-4xl grid-cols-3 border-y border-white/20 text-white backdrop-blur-sm">
        {[
          ["24/7", "coverage requests"],
          ["5", "Ontario branches"],
          ["Guard +", "systems planning"],
        ].map(([value, label]) => (
          <div class="border-r border-white/16 py-4 pr-3 last:border-r-0 sm:py-5">
            <p class="font-display text-3xl font-semibold leading-none sm:text-4xl">{value}</p>
            <p class="mt-2 font-utility text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-white/74">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden border-y border-[rgba(21,21,21,0.16)] bg-[#fffdf8]/78 py-12 md:py-14" aria-label="Client logos">
    <div class="section-shell">
      <div class="grid gap-3 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-3xl font-display text-3xl font-semibold leading-none md:text-5xl">Trusted across events, venues, municipalities, and businesses.</p>
        <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-[var(--ink-soft)]">Client and venue experience</p>
      </div>
    </div>
    <div class="mt-9 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
      <div class="logo-marquee flex w-max items-center gap-4 pr-4 hover:[animation-play-state:paused]">
        {[...clientLogos, ...clientLogos].map((logo) => (
          <div class="grid h-24 w-48 place-items-center rounded-sm border border-black/12 bg-white px-6">
            <img
              src={logo.src}
              alt={`${logo.name} logo`}
              loading="lazy"
              decoding="async"
              class="max-h-14 w-auto max-w-[9.5rem] object-contain grayscale transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:grayscale-0"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Services &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="max-w-4xl">
        <h2 class="headline section-title" data-motion-text="words">A disciplined field team backed by practical security systems.</h2>
        <p class="copy mt-6" data-reveal="fade-up">The strongest security plans rarely rely on one tool. Accure combines visible guard presence, patrol response, monitoring, camera coverage, and access control around the risks of each site.</p>
      </div>
      <div class="grid gap-0 border-t border-black/20" data-reveal-group>
        {trustSignals.map((signal, index) => (
          <div class="grid gap-5 border-b border-black/12 py-6 sm:grid-cols-[5rem_1fr]" data-reveal-item>
            <span class="font-utility text-sm font-semibold text-[var(--accure-red)]">0{index + 1}</span>
            <p class="text-lg font-semibold leading-7">{signal}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Services &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="max-w-5xl">
      <h2 class="headline section-title" data-motion-text="words">Physical security and digital security in one operating plan.</h2>
      <p class="copy mt-6" data-reveal="fade-up">Build coverage around the site: stationed officers when presence matters, patrols when deterrence must stay flexible, and monitoring systems when visibility needs to stay active.</p>
    </div>

    <div class="mt-16 grid gap-x-8 gap-y-14 border-t border-black/20 pt-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {featuredServices.map((service) => (
        <a href={serviceUrl(service)} class="group block" data-reveal-item>
          <article>
            <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:grayscale" />
            <div class="mt-5">
              <p class="font-utility text-[0.66rem] font-semibold uppercase tracking-[0.16em] text-[var(--accure-red-dark)]">/ {service.category}</p>
              <h3 class="mt-3 font-display card-title font-semibold">{service.shortTitle}</h3>
              <p class="mt-4 font-medium leading-7 text-[var(--ink)]">{service.summary}</p>
            </div>
          </article>
        </a>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4" data-reveal="fade-up">
      <a href="/security-services/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
        View physical services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
      </a>
      <a href="/security-systems/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
        View digital systems <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <figure class="w-full" data-image-reveal>
      <img src={portfolioImages[0].src} alt={portfolioImages[0].alt} loading="lazy" decoding="async" class="h-[48vh] min-h-[22rem] w-full object-cover" />
      <figcaption class="section-shell mt-3 font-utility text-[0.68rem] font-medium uppercase tracking-[0.16em] text-[var(--ink-soft)]">
        {portfolioImages[0].title} &middot; field documentation
      </figcaption>
    </figure>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Process &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div>
        <h2 class="headline section-title" data-motion-text="words">Coverage is built like a field procedure, not a generic guard schedule.</h2>
        <p class="copy mt-6" data-reveal="fade-up">Every property has different access points, hours, people movement, and risk patterns. Accure plans around those details.</p>
      </div>
      <div class="grid gap-0 border-t border-black/20" data-reveal-group>
        {processSteps.map((step) => (
          <article class="grid gap-5 border-b border-black/12 py-6 sm:grid-cols-[9rem_1fr]" data-reveal-item>
            <p class="font-utility text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accure-red-dark)]">{step.label}</p>
            <div>
              <h3 class="text-2xl font-extrabold tracking-tight">{step.title}</h3>
              <p class="copy mt-3">{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Locations &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="headline section-title" data-motion-text="words">Local landing pages for branch-backed search.</h2>
        <p class="copy mt-6" data-reveal="fade-up">Each location page is built around the branch address, surrounding service areas, local property needs, service links, and structured data.</p>
      </div>
      <div class="grid gap-0 border-t border-black/20 sm:grid-cols-2 sm:border-l" data-reveal-group>
        {locations.map((location) => (
          <a
            href={`/locations/${location.slug}/`}
            class="group border-b border-black/12 p-6 transition duration-300 hover:bg-[#fffaf1]/80 sm:border-r"
            data-reveal-item
          >
            <p class="font-utility text-xs font-semibold uppercase tracking-[0.17em] text-[var(--accure-red-dark)]">{location.label}</p>
            <h3 class="mt-4 font-display card-title font-semibold">{location.city}</h3>
            <p class="mt-4 text-sm font-semibold text-[var(--ink)]">{location.address}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">FAQ &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <h2 class="headline section-title" data-motion-text="words">Questions owners and organizers ask before booking security.</h2>
      <div class="grid gap-0 border-t border-black/20" data-reveal-group>
        {homepageFaqs.map((item) => (
          <details class="group border-b border-black/12 py-6" data-reveal-item>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold text-[var(--ink)]">
              <span>{item.question}</span>
              <span class="font-utility text-[var(--accure-red-dark)] transition duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="copy mt-4">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Contact &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <h2 class="headline max-w-4xl section-title" data-motion-text="words">Tell us what needs protecting.</h2>
      <div data-reveal="fade-up">
        <p class="copy max-w-xl">
          Share the property type, address, required hours, and risk concerns. Accure can shape a guard, patrol, event, monitoring, CCTV, or access-control plan around the site.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/contact/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
            Request a security quote <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/security-services/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
            Review services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
