---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { physicalServices, digitalServices, serviceUrl } from "@/data/services";
import { locations } from "@/data/locations";
import { homepageFaqs } from "@/data/faqs";
import { processSteps, trustSignals } from "@/data/site";
import { clientLogos } from "@/data/assets";
import { organizationSchema, websiteSchema, faqSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  websiteSchema(),
  faqSchema(homepageFaqs),
  breadcrumbSchema([{ name: "Home", url: "/" }]),
];

const featuredServices = [
  physicalServices[0],
  physicalServices[1],
  physicalServices[5],
  physicalServices[6],
  digitalServices[0],
  digitalServices[1],
];

const testimonials = [
  {
    quote:
      "Accure's team made the coverage feel organized from the first briefing. The guards understood the site flow, reported clearly, and kept the property presence visible without disrupting operations.",
    name: "A. Mehta",
    role: "Commercial property manager",
    context: "Multi-tenant site coverage",
  },
  {
    quote:
      "For our active site, we needed more than someone standing at a gate. The patrol notes, access checks, and escalation process gave our supervisors confidence after hours.",
    name: "Daniel R.",
    role: "Construction site coordinator",
    context: "After-hours perimeter protection",
  },
  {
    quote:
      "The front-desk presence was professional and calm. Residents had a clear point of contact, visitors were managed properly, and the reporting helped us stay ahead of recurring issues.",
    name: "M. Thompson",
    role: "Residential community manager",
    context: "Concierge and access control",
  },
];
---

<BaseLayout
  title="Accure Security | Security Guard Services Across Ontario"
  description="Accure Security provides security guards, mobile patrol, event security, construction site protection, remote monitoring, CCTV, and access control across Ontario."
  image="/images/services/control-centre-hero.jpg"
  schema={schema}
>
  <section class="relative min-h-[100dvh] overflow-hidden bg-[var(--charcoal)] text-[#fffdf8]" data-parallax-section>
    <div class="hero-carousel absolute inset-0" data-hero-carousel aria-hidden="true">
      {[
        {
          src: "/images/services/control-centre-hero.jpg",
          alt: "Accure Security officers monitoring live CCTV feeds inside the Accure control centre.",
        },
        {
          src: "/images/services/commercial-industrial-security.jpg",
          alt: "Accure Security officer on duty inside a commercial building lobby.",
        },
        {
          src: "/images/services/residential-concierge-security.jpg",
          alt: "Accure Security concierge officer welcoming a resident at a private residential entrance.",
        },
        {
          src: "/images/services/mobile-patrol-alarm-response.jpg",
          alt: "Accure Security mobile patrol officer standing beside a marked patrol vehicle.",
        },
      ].map((slide, index) => (
        <img
          src={slide.src}
          alt={slide.alt}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          class:list={["hero-slide absolute inset-0 h-[108%] w-full object-cover object-[50%_44%]", index === 0 && "is-active"]}
          data-hero-slide
          data-parallax-layer
          data-parallax-speed="0.04"
        />
      ))}
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(12,11,10,0.86)_0%,rgba(12,11,10,0.58)_36%,rgba(12,11,10,0.18)_72%,rgba(12,11,10,0.34)_100%),linear-gradient(180deg,rgba(12,11,10,0.30)_0%,rgba(12,11,10,0.08)_42%,rgba(12,11,10,0.82)_100%)]"></div>
    <div class="section-shell relative z-10 flex min-h-[100dvh] flex-col justify-end pb-10 pt-32 md:pb-12 md:pt-36">
      <div class="max-w-3xl">
        <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[#f0c4c6]">
          Ontario / Security Operations
        </p>
        <h1 class="font-display home-hero-title mt-6 font-semibold tracking-[0]" data-motion-text="words">
          Licensed security team for all types of facilities and events.
        </h1>
        <div class="mt-7 h-px max-w-2xl bg-white/24"></div>
        <p class="mt-6 max-w-[52ch] text-[1.03rem] font-semibold leading-8 text-[#fffdf8] md:text-[1.12rem]">
          Licensed guards, patrol response, event teams, fire watch, CCTV, access control, and remote monitoring for sites that need visible, documented coverage.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/contact/" data-magnetic="0.12" class="group inline-flex items-center justify-center gap-3 rounded-full bg-[var(--accure-red)] px-5 py-3.5 text-sm font-extrabold text-white shadow-[0_18px_45px_-25px_rgba(0,0,0,0.8)] transition duration-300 hover:bg-[#d3242c]">
            Request a security quote <span aria-hidden="true" class="grid h-8 w-8 place-items-center rounded-full bg-white text-[var(--accure-red)] transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/security-services/" data-magnetic="0.12" class="group inline-flex items-center justify-center gap-2 rounded-full border border-white/28 bg-white/10 px-5 py-3.5 font-utility text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-white backdrop-blur-md transition duration-300 hover:bg-white/18">
            Explore services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="mt-12 grid max-w-4xl grid-cols-3 border-y border-white/20 text-white backdrop-blur-sm">
        {[
          ["24/7", "coverage requests"],
          ["Licensed", "guard teams"],
          ["Guard +", "systems planning"],
        ].map(([value, label]) => (
          <div class="border-r border-white/16 px-2 py-4 last:border-r-0 sm:px-0 sm:pr-3 sm:py-5">
            <p class="font-display text-2xl font-semibold leading-none sm:text-4xl">{value}</p>
            <p class="mt-2 font-utility text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-white/74">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="overflow-hidden border-y border-[rgba(21,21,21,0.16)] bg-[#fffdf8]/78 py-12 md:py-14" aria-label="Client logos">
    <div class="section-shell">
      <div class="grid gap-3 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-3xl font-display text-3xl font-semibold leading-none md:text-5xl">Trusted across events, venues, municipalities, and businesses.</p>
        <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-[var(--ink-soft)]">Client and venue experience</p>
      </div>
    </div>
    <div class="mt-9 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
      <div class="logo-marquee flex w-max items-center gap-4 pr-4 hover:[animation-play-state:paused]">
        {[...clientLogos, ...clientLogos].map((logo) => (
          <div class="grid h-24 w-48 place-items-center rounded-sm border border-black/12 bg-white px-6">
            <img
              src={logo.src}
              alt={`${logo.name} logo`}
              loading="lazy"
              decoding="async"
              class="max-h-14 w-auto max-w-[9.5rem] object-contain transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Services &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="max-w-4xl">
        <h2 class="headline section-title" data-motion-text="words">A disciplined field team backed by practical security systems.</h2>
        <p class="copy mt-6" data-reveal="fade-up">The strongest security plans rarely rely on one tool. Accure combines visible guard presence, patrol response, monitoring, camera coverage, and access control around the risks of each site.</p>
      </div>
      <div class="grid gap-0 border-t border-black/20" data-reveal-group>
        {trustSignals.map((signal, index) => (
          <div class="grid gap-5 border-b border-black/12 py-6 sm:grid-cols-[5rem_1fr]" data-reveal-item>
            <span class="font-utility text-sm font-semibold text-[var(--accure-red)]">0{index + 1}</span>
            <p class="text-lg font-semibold leading-7">{signal}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Services &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="max-w-5xl">
      <h2 class="headline section-title" data-motion-text="words">Physical security and digital security in one operating plan.</h2>
      <p class="copy mt-6" data-reveal="fade-up">Build coverage around the site: stationed officers when presence matters, patrols when deterrence must stay flexible, and monitoring systems when visibility needs to stay active.</p>
    </div>

    <div class="mt-16 grid gap-6 border-t border-black/20 pt-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {featuredServices.map((service) => (
        <a href={serviceUrl(service)} class="service-card group" data-reveal-item>
          <article class="service-card-inner">
            <div class="service-card-media">
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" style={service.imageFocus ? `object-position: ${service.imageFocus}` : undefined} />
            </div>
            <div class="service-card-body">
              <p class="service-card-kicker">/ {service.category}</p>
              <h3 class="service-card-title">{service.shortTitle}</h3>
              <p class="service-card-copy">{service.summary}</p>
              <span class="service-card-footer">
                View service
                <span aria-hidden="true" class="service-card-icon">&rarr;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap gap-x-8 gap-y-4" data-reveal="fade-up">
      <a href="/security-services/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
        View physical services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
      </a>
      <a href="/security-systems/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
        View digital systems <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="field-proof-band py-16 text-[#fffdf8] md:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
      <div>
        <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[#f0c4c6]" data-reveal="fade-up">Field proof</p>
        <h2 class="headline section-title mt-5 text-[#fffdf8]" data-motion-text="words">Visible coverage where risk actually sits.</h2>
        <p class="mt-6 max-w-[58ch] text-[1.02rem] font-semibold leading-8 text-[#fffdf8]" data-reveal="fade-up">
          The proof section should feel operational, not decorative. This image anchors the site in site protection, perimeter awareness, and branded field presence beyond event coverage.
        </p>
        <div class="mt-8 grid max-w-xl grid-cols-3 border-y border-white/16 text-white" data-reveal="fade-up">
          {[
            ["Site", "perimeter checks"],
            ["Asset", "loss prevention"],
            ["Guard", "field presence"],
          ].map(([value, label]) => (
            <div class="border-r border-white/12 py-4 pr-3 last:border-r-0">
              <p class="font-display text-2xl font-extrabold leading-none">{value}</p>
              <p class="mt-2 font-utility text-[0.58rem] font-semibold uppercase tracking-[0.14em] text-white/72">{label}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-x-7 gap-y-4" data-reveal="fade-up">
          <a href="/security-services/construction-site-security/" class="group inline-flex items-center gap-2 border-b border-white/32 pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-white">
            Construction security <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/portfolio/" class="group inline-flex items-center gap-2 border-b border-white/32 pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-white">
            View portfolio <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>
      <figure class="field-proof-media" data-image-reveal>
        <img src="/images/services/construction-site-security.jpg" alt="Accure Security guard monitoring an active construction site perimeter." loading="lazy" decoding="async" />
        <figcaption>
          Construction site security / field documentation
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="process-band py-16 md:py-24">
    <div class="section-shell">
      <div class="grid gap-8 border-b border-black/16 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Process</p>
          <h2 class="headline section-title mt-5" data-motion-text="words">Coverage is built like a field procedure.</h2>
        </div>
        <p class="copy max-w-3xl lg:justify-self-end" data-reveal="fade-up">
          Every property has different access points, hours, people movement, and risk patterns. Accure plans around those details instead of dropping in a generic guard schedule.
        </p>
      </div>
      <div class="process-grid mt-8" data-reveal-group>
        {processSteps.map((step, index) => (
          <article class="process-step" data-reveal-item>
            <span class="process-step-number">0{index + 1}</span>
            <p class="process-step-label">{step.label}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-area-strip py-10 md:py-12" aria-label="Ontario service areas">
    <div class="section-shell">
      <div class="service-area-panel" data-reveal="fade-up">
        <div class="service-area-copy">
          <p class="font-utility text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Service areas</p>
          <h2 class="service-area-title">Ontario coverage areas.</h2>
          <p class="service-area-text">Branch-backed coverage details are available for nearby buyers who need local service context.</p>
        </div>
        <nav class="service-area-links" aria-label="Ontario location pages">
          {locations.map((location) => (
            <a
              href={`/locations/${location.slug}/`}
              class="service-area-link"
            >
              <span>{location.city}</span>
              <small>{location.nearby.slice(0, 2).join(" / ")}</small>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="testimonial-band py-16 md:py-24">
    <div class="section-shell">
      <div class="grid gap-8 border-b border-white/12 pb-10 text-[#fffdf8] lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
        <div>
          <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[#f0c4c6]">Testimonials</p>
          <h2 class="headline section-title mt-5 text-[#fffdf8]" data-motion-text="words">What clients value after coverage starts.</h2>
        </div>
        <p class="max-w-3xl text-[1.02rem] font-semibold leading-8 text-[#fffdf8]" data-reveal="fade-up">
          Buyers come for security coverage, but they stay with teams that communicate clearly, show up prepared, and make site activity easier to understand.
        </p>
      </div>
      <div class="testimonial-grid mt-8" data-reveal-group>
        {testimonials.map((testimonial, index) => (
          <article class:list={["testimonial-card", index === 0 && "testimonial-card-feature"]} data-reveal-item>
            <span class="testimonial-mark">"</span>
            <p class="testimonial-quote">{testimonial.quote}</p>
            <div class="testimonial-meta">
              <p>{testimonial.name}</p>
              <span class="testimonial-role">{testimonial.role}</span>
              <span class="testimonial-context">{testimonial.context}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">FAQ &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <h2 class="headline section-title" data-motion-text="words">Questions owners and organizers ask before booking security.</h2>
      <div class="grid gap-0 border-t border-black/20" data-reveal-group>
        {homepageFaqs.map((item) => (
          <details class="group border-b border-black/12 py-6" data-reveal-item>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold text-[var(--ink)]">
              <span>{item.question}</span>
              <span class="font-utility text-[var(--accure-red-dark)] transition duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="copy mt-4">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="mb-12">
      <p class="font-utility text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--accure-red-dark)]">Contact &mdash;</p>
      <div class="mt-3 h-px w-full bg-[rgba(21,21,21,0.2)]"></div>
    </div>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <h2 class="headline max-w-4xl section-title" data-motion-text="words">Tell us what needs protecting.</h2>
      <div data-reveal="fade-up">
        <p class="copy max-w-xl">
          Share the property type, address, required hours, and risk concerns. Accure can shape a guard, patrol, event, monitoring, CCTV, or access-control plan around the site.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/contact/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
            Request a security quote <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/security-services/" class="group inline-flex items-center gap-2 border-b border-transparent pb-1 font-utility text-[0.72rem] font-semibold uppercase tracking-[0.14em] transition duration-300 hover:border-[var(--accure-red)]">
            Review services <span aria-hidden="true" class="transition duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1400ms cubic-bezier(0.32, 0.72, 0, 1);
    pointer-events: none;
  }
  .hero-slide.is-active {
    opacity: 0.95;
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLImageElement>("[data-hero-slide]");
  if (slides.length > 1) {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!prefersReduced.matches) {
      let current = 0;
      window.setInterval(() => {
        slides[current].classList.remove("is-active");
        current = (current + 1) % slides.length;
        slides[current].classList.add("is-active");
      }, 5500);
    }
  }
</script>
