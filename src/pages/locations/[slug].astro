---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import { locations } from "@/data/locations";
import { physicalServices, digitalServices, serviceUrl } from "@/data/services";
import { organizationSchema, localBusinessSchema, faqSchema, breadcrumbSchema } from "@/data/schema";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const locationFaqs = [
  {
    question: `What security services are available in ${location.city}?`,
    answer: `Accure Security supports ${location.city} with guard coverage, mobile patrol, event security, construction security, residential concierge, healthcare security, remote monitoring, CCTV installation, and access control planning.`,
  },
  {
    question: `Can Accure support nearby areas around ${location.city}?`,
    answer: `Yes. Nearby service areas include ${location.nearby.join(", ")}. Coverage depends on the site, schedule, and required duties.`,
  },
  {
    question: "What is needed for a local quote?",
    answer:
      "Share the address, property type, coverage hours, start date, number of posts or patrol checks, and any known risk concerns.",
  },
];

const schema = [
  organizationSchema(),
  localBusinessSchema(location),
  faqSchema(locationFaqs),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: location.city, url: `/locations/${location.slug}/` },
  ]),
];
---

<BaseLayout
  title={location.metaTitle}
  description={location.metaDescription}
  canonical={`/locations/${location.slug}/`}
  image="/images/services/mobile-patrol-alarm-response.jpg"
  schema={schema}
>
  <section class="section-shell pt-28 pb-12 md:pt-36 md:pb-14">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.82fr] lg:items-end">
      <div>
        <span class="eyebrow" data-reveal="fade-up">{location.label}</span>
        <h1 class="headline mt-7 hero-title" data-motion-text="words">
          Security guards in {location.city}, {location.region}.
        </h1>
      </div>
      <div data-reveal="fade-up">
        <p class="copy">{location.intro}</p>
        <div class="mt-8">
          <Button href="/contact/" label={`Request ${location.city} coverage`} />
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pb-10 md:pb-16">
    <div class="bezel">
      <div class="bezel-core dark-panel grid gap-8 p-7 md:grid-cols-[0.7fr_1.3fr] md:p-10">
        <div>
          <p class="font-utility text-xs font-semibold uppercase tracking-[0.2em] text-[#f1e8db]">Branch address</p>
          <h2 class="mt-4 font-display card-title font-bold">{location.city}</h2>
        </div>
        <div>
          <p class="text-2xl font-semibold">{location.address}</p>
          {location.landmark && <p class="mt-3 font-medium text-[#fffdf8]">{location.landmark}</p>}
          <div class="mt-8 flex flex-wrap gap-2">
            {location.nearby.map((area: string) => (
              <span class="rounded-[0.65rem] bg-white/10 px-3 py-1 text-sm font-semibold text-[#fffdf8]">{area}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Local priorities</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">
          Common security needs around this branch.
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
        {location.priorities.map((priority: string) => (
          <div class="bezel" data-reveal-item>
            <div class="bezel-core p-6">
              <p class="font-semibold text-lg">{priority}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-panel py-16 text-[#fffdf8] md:py-24">
    <div class="section-shell">
      <div class="mb-12 max-w-4xl">
        <span class="eyebrow border-white/20 bg-white/12 text-[#fffdf8]" data-reveal="fade-up">Services in {location.city}</span>
        <h2 class="headline mt-6 section-title text-[#fffdf8]" data-motion-text="words">
          Physical and digital coverage available locally.
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {[...physicalServices, ...digitalServices].map((service) => (
          <a href={serviceUrl(service)} class="rounded-[1.15rem] border border-white/12 bg-white/10 p-5 transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5 hover:bg-white/15" data-reveal-item>
            <p class="card-title font-bold leading-none">{service.shortTitle}</p>
            <p class="mt-3 text-sm font-semibold text-[#fffdf8]">{service.eyebrow}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">FAQ</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">
          Local coverage questions.
        </h2>
      </div>
      <FAQ items={locationFaqs} />
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
