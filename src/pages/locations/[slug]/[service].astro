---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BezelImage from "@/components/BezelImage.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import { programmaticLocations } from "@/data/locations";
import { services, getService, serviceUrl } from "@/data/services";
import { organizationSchema, cityServiceSchema, faqSchema, breadcrumbSchema } from "@/data/schema";

export function getStaticPaths() {
  return programmaticLocations.flatMap((location) =>
    services.map((service) => ({
      params: { slug: location.slug, service: service.slug },
      props: { location, service },
    })),
  );
}

const { location, service } = Astro.props;
const canonical = `/locations/${location.slug}/${service.slug}/`;
const related = service.related?.map((slug: string) => getService(slug)).filter(Boolean) ?? [];
const localFaqs = [
  {
    question: `Is ${service.shortTitle.toLowerCase()} available in ${location.city}?`,
    answer: `Yes. Accure Security plans ${service.shortTitle.toLowerCase()} for ${location.city} properties based on the site, operating hours, access points, risk concerns, and required response procedures.`,
  },
  {
    question: `What properties in ${location.city} use ${service.shortTitle.toLowerCase()}?`,
    answer: `${service.useCases.join(", ")} can all require this coverage. The recommended approach depends on the property layout, people movement, assets, and reporting expectations.`,
  },
  {
    question: `Can Accure cover areas near ${location.city}?`,
    answer: `Coverage may also be available in ${location.nearby.join(", ")}. Confirm the property address and schedule when requesting a quote.`,
  },
];
const schema = [
  organizationSchema(),
  cityServiceSchema(location, service),
  faqSchema(localFaqs),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: location.city, url: `/locations/${location.slug}/` },
    { name: service.shortTitle, url: canonical },
  ]),
];
---

<BaseLayout
  title={`${service.shortTitle} in ${location.city}, Ontario | Accure Security`}
  description={`${service.shortTitle} in ${location.city}, Ontario for ${service.useCases.slice(0, 4).join(", ")}. Site-specific planning, documented coverage, and responsive support.`}
  canonical={canonical}
  image={service.image}
  schema={schema}
>
  <section class="section-shell pt-28 pb-12 md:pt-36 md:pb-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.82fr] lg:items-center">
      <div>
        <span class="eyebrow" data-reveal="fade-up">{location.city} · {service.category}</span>
        <h1 class="headline mt-7 hero-title" data-motion-text="words">{service.title} in {location.city}, Ontario.</h1>
        <p class="copy mt-7 max-w-2xl" data-reveal="fade-up">
          Accure Security provides {service.shortTitle.toLowerCase()} planning for {location.city} properties. {location.marketContext}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal="fade-up">
          <Button href="/contact/" label={`Request ${location.city} coverage`} />
          <Button href={`/locations/${location.slug}/`} label={`All ${location.city} services`} variant="secondary" />
        </div>
      </div>
      <BezelImage src={service.image} alt={`${service.imageAlt} Service available in ${location.city}, Ontario.`} priority imageClass="aspect-[4/3] min-h-[320px] object-cover lg:min-h-[420px]" imageStyle={`object-position: ${service.imageFocus ?? "50% 42%"}`} />
    </div>
  </section>

  <section class="section-shell py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Local coverage plan</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">Built around the property—not a generic package.</h2>
      </div>
      <div>
        <p class="copy">{service.summary}</p>
        <p class="copy mt-5">For {location.city} sites, coverage is planned around entrances, operating hours, people and vehicle movement, vulnerable areas, escalation contacts, and reporting requirements.</p>
        <div class="mt-7 flex flex-wrap gap-2">
          {[location.city, ...location.nearby].map((area: string) => <span class="rounded-[0.65rem] bg-[rgba(179,31,37,0.08)] px-3 py-1 text-sm font-semibold text-[var(--ink)]">{area}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="dark-panel py-16 text-[#fffdf8] md:py-24">
    <div class="section-shell grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <span class="eyebrow border-white/20 bg-white/12 text-[#fffdf8]" data-reveal="fade-up">Included in the plan</span>
        <h2 class="headline mt-6 section-title text-[#fffdf8]" data-motion-text="words">Practical {service.shortTitle.toLowerCase()} for {location.city}.</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2" data-reveal-group>
        {service.included.map((item: string) => <div class="rounded-[1.1rem] border border-white/12 bg-white/10 p-5 font-semibold text-[#fffdf8]" data-reveal-item>{item}</div>)}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Common applications</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">Where this coverage fits in {location.city}.</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
        {service.useCases.map((item: string) => <div class="bezel" data-reveal-item><div class="bezel-core p-6"><p class="font-semibold text-lg">{item}</p></div></div>)}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div><span class="eyebrow" data-reveal="fade-up">Local questions</span><h2 class="headline mt-6 section-title" data-motion-text="words">Before requesting coverage.</h2></div>
      <FAQ items={localFaqs} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-shell pb-16 md:pb-24">
      <div class="mb-9"><span class="eyebrow" data-reveal="fade-up">Related coverage</span><h2 class="headline mt-6 section-title" data-motion-text="words">Other services in {location.city}.</h2></div>
      <div class="grid gap-5 lg:grid-cols-3" data-reveal-group>
        {related.map((item) => item && <a href={`/locations/${location.slug}/${item.slug}/`} class="bezel group" data-reveal-item><article class="bezel-core h-full p-6"><p class="font-utility text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accure-red-dark)]">{item.category}</p><h3 class="mt-3 font-display card-title font-bold">{item.shortTitle}</h3><p class="mt-4 text-sm font-semibold">View {item.shortTitle.toLowerCase()} in {location.city}.</p></article></a>)}
      </div>
      <p class="mt-8 text-sm font-semibold"><a class="text-[var(--accure-red-dark)] underline underline-offset-4" href={serviceUrl(service)}>View the Ontario-wide {service.shortTitle.toLowerCase()} service page</a></p>
    </section>
  )}

  <QuoteBand />
</BaseLayout>
