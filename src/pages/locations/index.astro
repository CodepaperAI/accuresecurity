---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import { locations } from "@/data/locations";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
  ]),
];
---

<BaseLayout
  title="Ontario Security Guard Locations | Accure Security"
  description="Accure Security location pages for Cambridge, Mississauga, Vaughan, London, Toronto, and Scarborough security guard services."
  canonical="/locations/"
  image="/images/services/mobile-patrol-alarm-response.jpg"
  schema={schema}
>
  <section class="section-shell pt-36 pb-20 md:pt-44">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.82fr] lg:items-end">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Ontario coverage</span>
        <h1 class="headline mt-7 text-[clamp(4rem,11vw,10rem)]" data-motion-text="words">
          Branch-backed security pages for local search.
        </h1>
      </div>
      <div data-reveal="fade-up">
        <p class="copy">
          These location pages support local SEO and give property owners a clearer path to branch-specific guard, patrol, event, construction, healthcare, CCTV, and access control services.
        </p>
        <div class="mt-8">
          <Button href="/contact/" label="Request local coverage" />
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pb-24 md:pb-32">
    <div class="grid gap-5 lg:grid-cols-2" data-reveal-group>
      {locations.map((location) => (
        <a href={`/locations/${location.slug}/`} class="bezel group" data-reveal-item>
          <article class="bezel-core p-7">
            <p class="font-utility text-xs font-semibold uppercase tracking-[0.17em] text-[var(--accure-red-dark)]">{location.label}</p>
            <h2 class="mt-4 font-display text-5xl font-bold leading-none">{location.city}</h2>
            <p class="mt-5 font-semibold text-[var(--ink)]">{location.address}</p>
            {location.landmark && <p class="mt-2 text-sm font-semibold text-[var(--ink)]">{location.landmark}</p>}
            <div class="mt-7 flex flex-wrap gap-2">
              {location.priorities.slice(0, 4).map((priority) => (
                <span class="rounded-[0.65rem] bg-[rgba(179,31,37,0.08)] px-3 py-1 text-sm font-semibold text-[var(--ink)]">{priority}</span>
              ))}
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
