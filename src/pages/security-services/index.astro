---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MediaHero from "@/components/MediaHero.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import { physicalServices, digitalServices, serviceUrl } from "@/data/services";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Security Services", url: "/security-services/" },
  ]),
];
---

<BaseLayout
  title="Security Guard Services Ontario | Accure Security"
  description="Physical security services in Ontario including commercial security, residential concierge, event security, fire watch, healthcare security, mobile patrol, and construction site protection."
  canonical="/security-services/"
  image="/images/services/construction-site-security.jpg"
  schema={schema}
>
  <MediaHero
    eyebrow="Physical security services"
    title="Ontario security guard services for properties, sites, and events."
    text="Accure provides on-site guard coverage, concierge security, mobile patrol, fire watch, event security, healthcare security, and construction site protection. Each plan is shaped around access points, operating hours, risk level, and reporting needs."
    image="/images/services/construction-site-security.jpg"
    alt="Accure Security officer positioned at an active construction site."
    imagePosition="48% 45%"
    actions={[{ href: "/contact/", label: "Request guard coverage" }]}
  />

  <section class="section-shell py-14 md:py-20">
    <div class="grid gap-5 lg:grid-cols-12" data-reveal-group>
      {physicalServices.map((service, index) => (
        <a
          href={serviceUrl(service)}
          class:list={[
            "service-card service-card-directory group",
            index === 0 || index === 1 ? "lg:col-span-6" : "lg:col-span-4",
          ]}
          data-reveal-item
        >
          <article class="service-card-inner">
            <div class:list={["service-card-media service-card-media-tall", service.heroPortrait && "service-card-media-poster"]}>
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" style={!service.heroPortrait && service.imageFocus ? `object-position: ${service.imageFocus}` : undefined} />
            </div>
            <div class="service-card-body">
              <p class="service-card-kicker">{service.eyebrow}</p>
              <h2 class="service-card-title">{service.title}</h2>
              <p class="service-card-copy">{service.summary}</p>
              <span class="service-card-footer">
                View service
                <span aria-hidden="true" class="service-card-icon">&rarr;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell pb-14 md:pb-20">
    <div class="mb-10">
      <SectionIntro
        eyebrow="Digital security systems"
        title="Cameras, monitoring, and access control that support the field team."
        text="Guarding works best when it is layered with active visibility and controlled entry. Accure plans and installs digital security systems so the same team that patrols your site can also watch it, record it, and control who moves through it."
      />
    </div>
    <div class="grid gap-5 lg:grid-cols-3" data-reveal-group>
      {digitalServices.map((service) => (
        <a href={serviceUrl(service)} class="service-card service-card-directory group" data-reveal-item>
          <article class="service-card-inner">
            <div class:list={["service-card-media service-card-media-tall", service.heroPortrait && "service-card-media-poster"]}>
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" style={!service.heroPortrait && service.imageFocus ? `object-position: ${service.imageFocus}` : undefined} />
            </div>
            <div class="service-card-body">
              <p class="service-card-kicker">{service.eyebrow}</p>
              <h2 class="service-card-title">{service.title}</h2>
              <p class="service-card-copy">{service.summary}</p>
              <span class="service-card-footer">
                View system
                <span aria-hidden="true" class="service-card-icon">&rarr;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
