---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BezelImage from "@/components/BezelImage.astro";
import Button from "@/components/Button.astro";
import FAQ from "@/components/FAQ.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import { digitalServices, getService, serviceUrl } from "@/data/services";
import { physicalServices } from "@/data/services";
import { organizationSchema, serviceSchema, faqSchema, breadcrumbSchema } from "@/data/schema";

export function getStaticPaths() {
  return digitalServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const related = service.related?.map((slug: string) => getService(slug)).filter(Boolean) ?? [];
const schema = [
  organizationSchema(),
  serviceSchema(service),
  faqSchema(service.faqs),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Security Systems", url: "/security-systems/" },
    { name: service.title, url: serviceUrl(service) },
  ]),
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={serviceUrl(service)}
  image={service.image}
  schema={schema}
>
  <section class="section-shell pt-28 pb-12 md:pt-36 md:pb-14">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.78fr] lg:items-center">
      <div>
        <span class="eyebrow" data-reveal="fade-up">{service.eyebrow}</span>
        <h1 class="headline mt-7 hero-title" data-motion-text="words">{service.title}</h1>
        <p class="copy mt-7 max-w-2xl" data-reveal="fade-up">{service.summary}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal="fade-up">
          <Button href="/contact/" label="Plan this system" />
          <Button href="/security-services/" label="Pair with guards" variant="secondary" />
        </div>
      </div>
      <BezelImage src={service.image} alt={service.imageAlt} priority imageClass="aspect-[4/3] min-h-[320px] object-[50%_42%] lg:min-h-[420px]" />
    </div>
  </section>

  <section class="section-shell py-14 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">System outcomes</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">
          Designed to turn visibility into response.
        </h2>
      </div>
      <div class="grid gap-4" data-reveal-group>
        {service.outcomes.map((outcome: string, index: number) => (
          <article class="grid gap-4 border-t border-black/12 py-5 sm:grid-cols-[4rem_1fr]" data-reveal-item>
            <span class="font-utility text-sm font-semibold text-[var(--accure-red)]">0{index + 1}</span>
            <p class="text-xl font-semibold tracking-tight">{outcome}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="dark-panel py-16 text-[#fffdf8] md:py-24">
    <div class="section-shell grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <span class="eyebrow border-white/20 bg-white/12 text-[#fffdf8]" data-reveal="fade-up">System components</span>
        <h2 class="headline mt-6 section-title text-[#fffdf8]" data-motion-text="words">
          Security technology only works when the operating plan is clear.
        </h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2" data-reveal-group>
        {service.included.map((item: string) => (
          <div class="rounded-[1.1rem] border border-white/12 bg-white/10 p-5 font-semibold text-[#fffdf8]" data-reveal-item>
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">Guard integration</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">
          Digital coverage can support physical response.
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
        {physicalServices.slice(0, 4).map((item) => (
          <a href={serviceUrl(item)} class="bezel" data-reveal-item>
            <div class="bezel-core p-6">
              <p class="card-title font-bold">{item.shortTitle}</p>
              <p class="mt-3 text-sm font-semibold text-[var(--ink)]">{item.eyebrow}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <span class="eyebrow" data-reveal="fade-up">FAQ</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">
          Before installation or monitoring begins.
        </h2>
      </div>
      <FAQ items={service.faqs} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-shell py-16 md:py-24">
      <div class="mb-10">
        <span class="eyebrow" data-reveal="fade-up">Related coverage</span>
        <h2 class="headline mt-6 section-title" data-motion-text="words">Connect systems with the right field support.</h2>
      </div>
      <div class="grid gap-5 lg:grid-cols-3" data-reveal-group>
        {related.map((item) => (
          item && (
            <a href={serviceUrl(item)} class="bezel group" data-reveal-item>
              <article class="bezel-core h-full">
                <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" class="h-52 w-full object-cover transition duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.035]" />
                <div class="p-6">
                  <p class="font-utility text-xs font-semibold uppercase tracking-[0.16em] text-[var(--accure-red-dark)]">{item.category}</p>
                  <h3 class="mt-3 font-display card-title font-bold">{item.shortTitle}</h3>
                </div>
              </article>
            </a>
          )
        ))}
      </div>
    </section>
  )}

  <QuoteBand />
</BaseLayout>
