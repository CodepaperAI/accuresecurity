---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MediaHero from "@/components/MediaHero.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import { digitalServices, serviceUrl } from "@/data/services";
import { organizationSchema, breadcrumbSchema } from "@/data/schema";

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Security Systems", url: "/security-systems/" },
  ]),
];
---

<BaseLayout
  title="Security Systems Ontario | CCTV, Monitoring, Access Control"
  description="Digital security services in Ontario including live remote monitoring, CCTV camera installation, and access control systems for homes and businesses."
  canonical="/security-systems/"
  image="/images/services/camera-system-installation-cctv.jpg"
  schema={schema}
>
  <MediaHero
    eyebrow="Digital security systems"
    title="Cameras, access, and monitoring systems."
    text="Cameras and access systems work best when they are planned around movement, blind spots, restricted zones, alerts, and response procedures. Accure helps connect visibility with action."
    image="/images/services/camera-system-installation-cctv.jpg"
    alt="Accure Security technician installing a CCTV camera at a commercial entry point."
    actions={[{ href: "/contact/", label: "Plan security systems" }]}
  />

  <section class="section-shell py-14 md:py-20">
    <div class="grid gap-5 lg:grid-cols-3" data-reveal-group>
      {digitalServices.map((service) => (
        <a href={serviceUrl(service)} class="service-card service-card-directory group" data-reveal-item>
          <article class="service-card-inner">
            <div class="service-card-media service-card-media-tall">
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" style={service.imageFocus ? `object-position: ${service.imageFocus}` : undefined} />
            </div>
            <div class="service-card-body">
              <p class="service-card-kicker">{service.eyebrow}</p>
              <h2 class="service-card-title">{service.title}</h2>
              <p class="service-card-copy">{service.summary}</p>
              <span class="service-card-footer">
                View service
                <span aria-hidden="true" class="service-card-icon">&rarr;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <QuoteBand />
</BaseLayout>
